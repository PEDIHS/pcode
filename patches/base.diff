+/// Whether a paragraph reads right to left: its first strong letter is from
+/// a right-to-left script such as Persian or Arabic (UAX #9, rules P2/P3).
+pub(crate) fn starts_rtl(text: &str) -> bool {
+    for c in text.chars() {
+        if matches!(c as u32, 0x0590..=0x08FF | 0xFB1D..=0xFDFF | 0xFE70..=0xFEFF) {
+            return true;
+        }
+        if c.is_alphabetic() {
+            return false;
+        }
+    }
+    false
+}
