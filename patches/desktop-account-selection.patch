+
+// Score the tightest quota window, not an average that can hide exhaustion.
+fn usable_quota(values: &[f32]) -> Option<f32> {
+    if values.is_empty() || values.iter().any(|v| !v.is_finite() || *v < 0.0 || *v >= 100.0) {
+        return None;
+    }
+    values.iter().copied().reduce(f32::max)
+}
+
+#[cfg(test)]
+mod quota_tests {
+    use super::usable_quota;
+    #[test]
+    fn exhausted_weekly_quota_is_not_hidden_by_free_short_window() {
+        assert_eq!(usable_quota(&[0.0, 100.0]), None);
+        assert_eq!(usable_quota(&[23.0, 92.0]), Some(92.0));
+        assert!(usable_quota(&[8.0, 3.0]) < usable_quota(&[23.0, 92.0]));
+    }
+    #[test]
+    fn unknown_or_invalid_quotas_do_not_look_free() {
+        for values in [vec![], vec![f32::NAN], vec![-1.0], vec![10.0, f32::INFINITY]] {
+            assert_eq!(usable_quota(&values), None);
+        }
+    }
+}
